/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model audit_logs {
  id          BigInt    @id @default(autoincrement())
  actor_id    String?   @db.Uuid
  entity_type String    @db.VarChar(80)
  entity_id   String?   @db.Uuid
  action      String    @db.VarChar(80)
  details     Json      @default("{}")
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  profiles    profiles? @relation(fields: [actor_id], references: [id], onUpdate: NoAction)

  @@index([actor_id, created_at(sort: Desc)], map: "audit_logs_actor_idx")
  @@index([entity_type, entity_id, created_at(sort: Desc)], map: "audit_logs_entity_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model invitations {
  id                                         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                      String                 @db.Citext
  target_type                                invitation_target_type
  target_id                                  String                 @db.Uuid
  invited_by                                 String                 @db.Uuid
  role                                       String?                @db.VarChar(32)
  token_hash                                 String                 @unique
  status                                     invitation_status      @default(PENDING)
  expires_at                                 DateTime               @default(dbgenerated("(now() + '7 days'::interval)")) @db.Timestamptz(6)
  accepted_by                                String?                @db.Uuid
  accepted_at                                DateTime?              @db.Timestamptz(6)
  created_at                                 DateTime               @default(now()) @db.Timestamptz(6)
  profiles_invitations_accepted_byToprofiles profiles?              @relation("invitations_accepted_byToprofiles", fields: [accepted_by], references: [id], onUpdate: NoAction)
  profiles_invitations_invited_byToprofiles  profiles               @relation("invitations_invited_byToprofiles", fields: [invited_by], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([email, status])
  @@index([target_type, target_id], map: "invitations_target_idx")
}

